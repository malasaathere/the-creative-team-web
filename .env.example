# Public URL of the site (used for metadata, sitemap and robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact / booking / order enquiries are emailed through Resend.
# Leave these empty in development: enquiries are logged to the console instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend
CONTACT_FROM_EMAIL="crentive website <hello@yourdomain.com>"
